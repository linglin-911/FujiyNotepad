<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FujiyNotepad.WinUI.CaretTestWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="光标技术测试">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Padding="22" RowSpacing="14" Background="#202020">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="5">
            <TextBlock Text="光标技术测试"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#F4F4F4" />
            <TextBlock Text="独立实验窗口，不连接小说项目、批注数据库或正式编辑器。先比较原生光标，再测试 WPF 式双层光标。"
                       TextWrapping="Wrap"
                       Foreground="#B8B8B8" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="光标模式"
                       VerticalAlignment="Center"
                       Foreground="#E0E0E0" />
            <ComboBox x:Name="ModeSelector"
                      Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      SelectedIndex="0"
                      SelectionChanged="ModeSelector_SelectionChanged">
                <ComboBoxItem Content="原生光标（对照）" />
                <ComboBoxItem Content="WPF 式双层光标（自绘）" />
            </ComboBox>
            <Button Grid.Column="2"
                    Content="聚焦输入框"
                    Click="FocusEditor_Click" />
            <Button Grid.Column="3"
                    Content="清空文本"
                    Click="ClearText_Click" />
            <Button Grid.Column="4"
                    Content="填充长文本"
                    Click="FillLongText_Click" />
        </Grid>

        <Grid Grid.Row="2">
            <TextBox x:Name="EditorTextBox"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     FontFamily="Microsoft YaHei"
                     FontSize="18"
                     Padding="14"
                     Background="#303030"
                     Foreground="#F4F4F4"
                     BorderBrush="#666666"
                     BorderThickness="1"
                     PlaceholderText="在这里输入中文、英文，尝试换行、移动光标和滚动……"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     TextChanged="EditorTextBox_TextChanged"
                     SelectionChanged="EditorTextBox_SelectionChanged"
                     GotFocus="EditorTextBox_GotFocus"
                     LostFocus="EditorTextBox_LostFocus"
                     KeyUp="EditorTextBox_KeyUp"
                     PointerReleased="EditorTextBox_PointerReleased"
                     SizeChanged="EditorTextBox_SizeChanged" />

            <Canvas x:Name="CaretOverlay"
                    IsHitTestVisible="False"
                    ClipToBounds="True">
                <Border x:Name="CustomCaret"
                        Width="2"
                        Height="22"
                        Background="#FF55C8FF"
                        CornerRadius="1"
                        Visibility="Collapsed" />
            </Canvas>
        </Grid>

        <StackPanel Grid.Row="3" Spacing="5">
            <TextBlock x:Name="ModeStatusText"
                       Foreground="#E0E0E0"
                       Text="当前模式：原生光标（对照）" />
            <TextBlock x:Name="SystemCaretStatusText"
                       Foreground="#A8D8A8"
                       Text="尚未启用自绘光标。" />
            <TextBlock x:Name="DiagnosticsText"
                       Foreground="#B8B8B8"
                       TextWrapping="Wrap"
                       Text="等待输入框获得焦点。" />
            <TextBlock Text="建议测试：连续输入超过 10 秒；中文拼音组合输入；方向键移动；鼠标点击定位；Shift 选区；清空文本；末尾换行；填充长文本后滚动。"
                       TextWrapping="Wrap"
                       Foreground="#A0A0A0" />
        </StackPanel>
    </Grid>
</Window>
