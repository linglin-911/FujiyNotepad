<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FujiyNotepad.WinUI.ReaderSettingsPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="16" Spacing="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Uid="ReaderSettingsPaneTitle"
                           Text="Reader Settings" FontSize="18" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button x:Uid="ReaderSettingsPaneCloseButton" Grid.Column="1"
                        AutomationProperties.AutomationId="ReaderSettingsPaneCloseButton"
                        Content="&#x2715;" MinWidth="32" Padding="6,3"
                        Click="Close_Click" />
            </Grid>

            <TextBlock x:Uid="ReaderSettingsLiveNote"
                       Text="Changes apply immediately and are saved automatically."
                       TextWrapping="Wrap" Opacity="0.75" />

            <StackPanel Spacing="6">
                <TextBlock x:Uid="ReaderSettingsFontFamilyLabel"
                           Text="Font family" FontWeight="SemiBold" />
                <ComboBox x:Name="FontFamilyComboBox"
                          HorizontalAlignment="Stretch" MaxDropDownHeight="400"
                          SelectionChanged="FontFamilyComboBox_SelectionChanged" />
            </StackPanel>

            <StackPanel Spacing="6">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="ReaderSettingsFontSizeLabel"
                               Text="Font size" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="FontSizeValueText" Grid.Column="1"
                               VerticalAlignment="Center" />
                </Grid>
                <Slider x:Name="FontSizeSlider" Minimum="6" Maximum="72"
                        StepFrequency="1" Value="18"
                        ValueChanged="FontSizeSlider_ValueChanged" />
            </StackPanel>

            <StackPanel Spacing="6">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="ReaderSettingsLineSpacingLabel"
                               Text="Line spacing" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="LineSpacingValueText" Grid.Column="1"
                               VerticalAlignment="Center" />
                </Grid>
                <Slider x:Name="LineSpacingSlider" Minimum="0.8" Maximum="2.5"
                        StepFrequency="0.1" Value="1.4"
                        ValueChanged="LineSpacingSlider_ValueChanged" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock x:Uid="ReaderSettingsContentWidthLabel"
                           Text="Content width" FontWeight="SemiBold" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="132" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <NumberBox x:Name="ContentWidthNumberBox" Width="128"
                               Minimum="480" Maximum="2400" Value="900"
                               SmallChange="20" LargeChange="100"
                               SpinButtonPlacementMode="Inline"
                               ValueChanged="ContentWidthNumberBox_ValueChanged" />
                    <TextBlock Grid.Column="1" Text="DIP"
                               VerticalAlignment="Center" />
                </Grid>
                <CheckBox x:Name="AdaptiveWidthCheckBox"
                          x:Uid="ReaderSettingsAdaptiveWidthCheckBox"
                          Content="Adapt to available width"
                          Checked="AdaptiveWidthCheckBox_Changed"
                          Unchecked="AdaptiveWidthCheckBox_Changed" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock x:Uid="ReaderSettingsThemeLabel"
                           Text="Reading background" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <RadioButton x:Name="PaperThemeRadio" GroupName="ReaderTheme"
                                 Tag="Paper" Checked="ThemeRadio_Checked">
                        <StackPanel Width="84" Spacing="5">
                            <Border x:Name="PaperThemeSwatch" Height="42" CornerRadius="5"
                                    BorderThickness="1">
                                <TextBlock x:Name="PaperThemeSwatchText" Text="Aa" FontSize="23"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Uid="ReaderSettingsPaperThemeLabel"
                                       Text="Paper" HorizontalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="WarmThemeRadio" GroupName="ReaderTheme"
                                 Tag="Warm" Checked="ThemeRadio_Checked">
                        <StackPanel Width="84" Spacing="5">
                            <Border x:Name="WarmThemeSwatch" Height="42" CornerRadius="5"
                                    BorderThickness="1">
                                <TextBlock x:Name="WarmThemeSwatchText" Text="Aa" FontSize="23"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Uid="ReaderSettingsWarmThemeLabel"
                                       Text="Warm" HorizontalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NightThemeRadio" GroupName="ReaderTheme"
                                 Tag="Night" Checked="ThemeRadio_Checked">
                        <StackPanel Width="84" Spacing="5">
                            <Border x:Name="NightThemeSwatch" Height="42" CornerRadius="5"
                                    BorderThickness="1">
                                <TextBlock x:Name="NightThemeSwatchText" Text="Aa" FontSize="23"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Uid="ReaderSettingsNightThemeLabel"
                                       Text="Night" HorizontalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </StackPanel>

            <TextBlock x:Uid="ReaderSettingsHighContrastNote"
                       Text="Windows High Contrast overrides the selected reading background for accessibility."
                       TextWrapping="Wrap" Opacity="0.75" />
            <TextBlock x:Uid="ReaderSettingsGlobalNote"
                       Text="These settings apply to all novel projects."
                       TextWrapping="Wrap" Opacity="0.75" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
