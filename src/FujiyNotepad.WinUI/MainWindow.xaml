<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FujiyNotepad.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FujiyNotepad.WinUI"
    xmlns:core="using:FujiyNotepad.Core"
    xmlns:controls="using:FujiyNotepad.WinUI.Controls"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Fujiy Notepad">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" KeyboardAcceleratorPlacementMode="Hidden" AllowDrop="True"
          DragOver="Root_DragOver" Drop="Root_Drop">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F3" Invoked="FindNextAccelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Shift" Key="F3" Invoked="FindPreviousAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.Resources>
            <!-- Shared chrome for the Find/Filter option toggles (Aa, [ab], .*) so the two bars stay consistent. -->
            <Style x:Key="OptionToggleStyle" TargetType="ToggleButton">
                <Setter Property="MinWidth" Value="36" />
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="FontFamily" Value="Consolas" />
            </Style>
        </Grid.Resources>

        <MenuBar Grid.Row="0">
            <MenuBarItem x:Uid="FileMenu" Title="File">
                <MenuFlyoutItem x:Uid="OpenItem" Text="Open..." Click="Open_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="O" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="OpenSampleItem" Text="Open Sample" Click="OpenSample_Click" />
                <MenuFlyoutSubItem x:Uid="RecentMenu" x:Name="RecentMenu" Text="Open Recent" />
                <ToggleMenuFlyoutItem x:Uid="ReopenLastToggle" x:Name="ReopenLastToggle" Text="Reopen Last File on Startup" Click="ReopenLast_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="ReloadItem" x:Name="ReloadItem" Text="Reload" Click="Reload_Click" IsEnabled="False">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="CloseItem" x:Name="CloseItem" Text="Close" Click="CloseFile_Click" IsEnabled="False">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="W" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="CopyPathItem" x:Name="CopyPathItem" Text="Copy File Path" Click="CopyFilePath_Click" IsEnabled="False" />
                <MenuFlyoutItem x:Uid="RevealItem" x:Name="RevealItem" Text="Reveal in Explorer" Click="RevealInExplorer_Click" IsEnabled="False" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="ExitItem" Text="Exit" Click="Exit_Click" KeyboardAcceleratorTextOverride="Alt+F4" />
            </MenuBarItem>
            <MenuBarItem x:Name="NovelProjectMenu" Title="Novel Project">
                <MenuFlyoutItem x:Name="CreateProjectItem" Text="Import TXT as New Project..." Click="CreateNovelProject_Click" IsEnabled="True" />
                <MenuFlyoutItem x:Name="OpenProjectItem" Text="Open Project Folder..." Click="OpenNovelProject_Click" />
                <MenuFlyoutSeparator />
                <ToggleMenuFlyoutItem x:Name="ChapterDirectoryItem" Text="章节目录" Click="ChapterDirectory_Click" IsEnabled="False" />
                <ToggleMenuFlyoutItem x:Name="SmallAnnotationsItem" Text="小批注面板" Click="SmallAnnotations_Click" IsEnabled="False" />
                <ToggleMenuFlyoutItem x:Name="ChapterAnnotationsItem" Text="章节批注面板" Click="ChapterAnnotations_Click" IsEnabled="False" />
                <ToggleMenuFlyoutItem x:Name="BigAnnotationsItem" Text="大批注工作区" Click="BigAnnotations_Click" IsEnabled="False" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="ExportMarkedCopyItem" Text="Export Marked Working Copy..." Click="ExportMarkedCopy_Click" IsEnabled="False" />
                <MenuFlyoutItem x:Name="ValidateEditedCopyItem" Text="Validate Edited Copy..." Click="ValidateEditedCopy_Click" IsEnabled="False" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="CloseProjectItem" Text="Close Novel Project" Click="CloseNovelProject_Click" IsEnabled="False" />
            </MenuBarItem>
            <MenuBarItem x:Uid="EditMenu" x:Name="EditMenu" Title="Edit" IsEnabled="False">
                <MenuFlyoutItem x:Uid="GoToLineItem" Text="Go To Line..." Click="GoTo_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="G" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="GoToOffsetItem" Text="Go To Offset..." Click="GoToOffset_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control,Shift" Key="G" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="GoToPercentItem" Text="Go To Percentage..." Click="GoToPercent_Click" />
                <MenuFlyoutItem x:Uid="FindItem" Text="Find..." Click="Find_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="F" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="FilterItem" Text="Filter..." Click="Filter_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control,Shift" Key="F" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="CopyMatchingItem" x:Name="CopyMatchingItem" Text="Copy Matching Lines" Click="CopyMatchingLines_Click" IsEnabled="False" />
                <MenuFlyoutItem x:Uid="SaveMatchingItem" x:Name="SaveMatchingItem" Text="Save Matching Lines As..." Click="SaveMatchingLines_Click" IsEnabled="False" />
                <MenuFlyoutItem x:Uid="ClearSearchHistoryItem" Text="Clear Search History" Click="ClearSearchHistory_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="ToggleBookmarkItem" Text="Toggle Bookmark" Click="ToggleBookmark_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="F2" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="NextBookmarkItem" Text="Next Bookmark" Click="NextBookmark_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F2" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="PreviousBookmarkItem" Text="Previous Bookmark" Click="PreviousBookmark_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Shift" Key="F2" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="ClearBookmarksItem" Text="Clear All Bookmarks" Click="ClearBookmarks_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="CopyWithLineNumbersItem" Text="Copy with Line Numbers" Click="CopyWithLineNumbers_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control,Shift" Key="C" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="StartIndexingItem" x:Name="StartIndexingItem" Text="Start indexing" Click="StartIndexing_Click" IsEnabled="False" />
                <MenuFlyoutItem x:Uid="StopIndexingItem" x:Name="StopIndexingItem" Text="Stop indexing" Click="StopIndexing_Click" IsEnabled="False" />
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem x:Uid="TabWidthSubMenu" Text="Tab Width">
                    <RadioMenuFlyoutItem x:Name="TabWidth2" Text="2" GroupName="TabWidth" Tag="2" Click="TabWidth_Click" />
                    <RadioMenuFlyoutItem x:Name="TabWidth4" Text="4" GroupName="TabWidth" Tag="4" Click="TabWidth_Click" />
                    <RadioMenuFlyoutItem x:Name="TabWidth8" Text="8" GroupName="TabWidth" Tag="8" Click="TabWidth_Click" />
                </MenuFlyoutSubItem>
            </MenuBarItem>
            <MenuBarItem x:Uid="ViewMenu" x:Name="ViewMenu" Title="View">
                <ToggleMenuFlyoutItem x:Uid="LineNumbersToggle" x:Name="LineNumbersToggle" Text="Line Numbers" Click="LineNumbers_Click" />
                <ToggleMenuFlyoutItem x:Uid="WhitespaceToggle" x:Name="WhitespaceToggle" Text="Show Whitespace" Click="Whitespace_Click" />
                <ToggleMenuFlyoutItem x:Uid="WordWrapToggle" x:Name="WordWrapToggle" Text="Word Wrap" Click="WordWrap_Click" />
                <ToggleMenuFlyoutItem x:Uid="ReadingModeToggle" x:Name="ReadingModeToggle" Text="Reading Mode" Click="ReadingMode_Click">
                    <ToggleMenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control,Shift" Key="R" />
                    </ToggleMenuFlyoutItem.KeyboardAccelerators>
                </ToggleMenuFlyoutItem>
                <ToggleMenuFlyoutItem x:Uid="HighlightSelectionToggle" x:Name="HighlightSelectionToggle" Text="Highlight Selection Occurrences" Click="HighlightSelection_Click" />
                <ToggleMenuFlyoutItem x:Uid="FollowTailToggle" x:Name="FollowTailToggle" Text="Follow Tail" Click="FollowTail_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="ZoomInItem" Text="Zoom In" Click="ZoomIn_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Add" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="ZoomOutItem" Text="Zoom Out" Click="ZoomOut_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Subtract" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="ResetZoomItem" Text="Reset Zoom" Click="ResetZoom_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Number0" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem x:Uid="FontSubMenu" Text="Font">
                    <RadioMenuFlyoutItem x:Name="FontMicrosoftYaHei" Text="Microsoft YaHei" GroupName="Font" Tag="Microsoft YaHei" Click="Font_Click" />
                    <RadioMenuFlyoutItem x:Name="FontConsolas" Text="Consolas" GroupName="Font" Tag="Consolas" Click="Font_Click" />
                    <RadioMenuFlyoutItem x:Name="FontCascadiaMono" Text="Cascadia Mono" GroupName="Font" Tag="Cascadia Mono" Click="Font_Click" />
                    <RadioMenuFlyoutItem x:Name="FontCascadiaCode" Text="Cascadia Code" GroupName="Font" Tag="Cascadia Code" Click="Font_Click" />
                    <RadioMenuFlyoutItem x:Name="FontCourierNew" Text="Courier New" GroupName="Font" Tag="Courier New" Click="Font_Click" />
                    <RadioMenuFlyoutItem x:Name="FontLucidaConsole" Text="Lucida Console" GroupName="Font" Tag="Lucida Console" Click="Font_Click" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem x:Uid="ApplicationThemeSubMenu" Text="Application Theme">
                    <RadioMenuFlyoutItem x:Uid="ThemeSystem" x:Name="ThemeSystem" Text="System" GroupName="Theme" Tag="System" Click="Theme_Click" />
                    <RadioMenuFlyoutItem x:Uid="ThemeLight" x:Name="ThemeLight" Text="Light" GroupName="Theme" Tag="Light" Click="Theme_Click" />
                    <RadioMenuFlyoutItem x:Uid="ThemeDark" x:Name="ThemeDark" Text="Dark" GroupName="Theme" Tag="Dark" Click="Theme_Click" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="ReaderSettingsItem" x:Name="ReaderSettingsItem" Text="Reader Settings..." Click="ReaderSettings_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="HighlightRulesItem" Text="Highlight Rules..." Click="HighlightRules_Click" />
            </MenuBarItem>
            <MenuBarItem x:Uid="EncodingMenu" x:Name="EncodingMenu" Title="Encoding" IsEnabled="False">
                <RadioMenuFlyoutItem x:Uid="EncAuto" x:Name="EncAuto" Text="Auto-detect" GroupName="Encoding" Tag="" Click="Encoding_Click" />
                <MenuFlyoutSeparator />
                <RadioMenuFlyoutItem x:Name="EncUtf8" Text="UTF-8" GroupName="Encoding" Tag="utf-8" Click="Encoding_Click" />
                <RadioMenuFlyoutItem x:Name="EncUtf8Bom" Text="UTF-8 with BOM" GroupName="Encoding" Tag="utf-8-bom" Click="Encoding_Click" />
                <RadioMenuFlyoutItem x:Name="EncUtf16Le" Text="UTF-16 LE" GroupName="Encoding" Tag="utf-16le" Click="Encoding_Click" />
                <RadioMenuFlyoutItem x:Name="EncUtf16Be" Text="UTF-16 BE" GroupName="Encoding" Tag="utf-16be" Click="Encoding_Click" />
                <RadioMenuFlyoutItem x:Name="EncUtf32Le" Text="UTF-32 LE" GroupName="Encoding" Tag="utf-32le" Click="Encoding_Click" />
                <RadioMenuFlyoutItem x:Name="EncUtf32Be" Text="UTF-32 BE" GroupName="Encoding" Tag="utf-32be" Click="Encoding_Click" />
                <RadioMenuFlyoutItem x:Name="EncWindows1252" Text="Windows-1252 (ANSI)" GroupName="Encoding" Tag="windows-1252" Click="Encoding_Click" />
            </MenuBarItem>
            <MenuBarItem x:Uid="HelpMenu" Title="Help">
                <MenuFlyoutItem x:Uid="AboutItem" Text="About FujiyNotepad..." Click="About_Click" />
            </MenuBarItem>
        </MenuBar>

        <Grid x:Name="FindBar" Grid.Row="1" Visibility="Collapsed" Padding="8,4" ColumnSpacing="6"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <!-- The search box is the only flexible (*) column; every variable-width widget to its right
                 (status text, match count, and the search-progress area) has a fixed-width column. That
                 keeps the * column - and therefore the option toggles and Find Next button - from shifting
                 when those labels change between empty / "counting…" / a count / a line number. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="184" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Uid="FindBox" x:Name="FindBox" Grid.Column="0" PlaceholderText="Find" VerticalAlignment="Center"
                     TextChanged="FindBox_TextChanged" KeyDown="FindBox_KeyDown" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <ToggleButton x:Uid="MatchCaseToggle" x:Name="MatchCaseToggle" Content="Aa" Style="{StaticResource OptionToggleStyle}"
                              ToolTipService.ToolTip="Match case"
                              AutomationProperties.Name="Match case"
                              Checked="FindOption_Toggled" Unchecked="FindOption_Toggled" />
                <ToggleButton x:Uid="WholeWordToggle" x:Name="WholeWordToggle" Content="[ab]" Style="{StaticResource OptionToggleStyle}" MinWidth="40"
                              ToolTipService.ToolTip="Match whole word"
                              AutomationProperties.Name="Match whole word"
                              Checked="FindOption_Toggled" Unchecked="FindOption_Toggled" />
                <ToggleButton x:Uid="RegexToggle" x:Name="RegexToggle" Content=".*" Style="{StaticResource OptionToggleStyle}"
                              ToolTipService.ToolTip="Use regular expression"
                              AutomationProperties.Name="Use regular expression"
                              Checked="FindOption_Toggled" Unchecked="FindOption_Toggled" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button x:Uid="FindPrevButton" x:Name="FindPrevButton" Content="Find Previous" Click="FindPrev_Click"
                        ToolTipService.ToolTip="Find previous (Shift+F3)" />
                <Button x:Uid="FindNextButton" x:Name="FindNextButton" Content="Find Next" Click="FindNext_Click"
                        ToolTipService.ToolTip="Find next (F3)" />
            </StackPanel>

            <TextBlock x:Name="FindStatus" Grid.Column="3" VerticalAlignment="Center" Margin="4,0"
                       TextTrimming="CharacterEllipsis" />

            <TextBlock x:Name="FindCount" Grid.Column="4" VerticalAlignment="Center" Margin="4,0"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <ProgressBar x:Name="FindProgress" Width="100" Minimum="0" Maximum="100"
                             VerticalAlignment="Center" Visibility="Collapsed" />
                <Button x:Uid="FindCancelButton" x:Name="FindCancelButton" Content="Cancel" VerticalAlignment="Center"
                        Visibility="Collapsed" Click="FindCancel_Click" />
            </StackPanel>

            <Button x:Uid="FindCloseButton" Grid.Column="6" Content="&#x2715;" VerticalAlignment="Center" Click="FindClose_Click"
                    AutomationProperties.Name="Close find bar"
                    ToolTipService.ToolTip="Close" />
        </Grid>

        <Grid x:Name="FilterBar" Grid.Row="2" Visibility="Collapsed" Padding="8,4" ColumnSpacing="6"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Uid="FilterBox" x:Name="FilterBox" Grid.Column="0" PlaceholderText="Filter — show only lines that match"
                     VerticalAlignment="Center" KeyDown="FilterBox_KeyDown" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <DropDownButton x:Uid="FilterSeverity" Content="Severity" Margin="0,0,4,0"
                                AutomationProperties.AutomationId="FilterSeverity"
                                AutomationProperties.Name="Filter by minimum severity"
                                ToolTipService.ToolTip="Replace the filter with a severity preset and apply immediately">
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Uid="SeverityTrace" Text="Trace+" Tag="Trace" Click="FilterSeverity_Click"
                                            AutomationProperties.AutomationId="SeverityTrace" />
                            <MenuFlyoutItem x:Uid="SeverityDebug" Text="Debug+" Tag="Debug" Click="FilterSeverity_Click"
                                            AutomationProperties.AutomationId="SeverityDebug" />
                            <MenuFlyoutItem x:Uid="SeverityInfo" Text="Info+" Tag="Info" Click="FilterSeverity_Click"
                                            AutomationProperties.AutomationId="SeverityInfo" />
                            <MenuFlyoutItem x:Uid="SeverityWarn" Text="Warn+" Tag="Warn" Click="FilterSeverity_Click"
                                            AutomationProperties.AutomationId="SeverityWarn" />
                            <MenuFlyoutItem x:Uid="SeverityError" Text="Error+" Tag="Error" Click="FilterSeverity_Click"
                                            AutomationProperties.AutomationId="SeverityError" />
                            <MenuFlyoutItem x:Uid="SeverityFatal" Text="Fatal / Critical" Tag="Fatal" Click="FilterSeverity_Click"
                                            AutomationProperties.AutomationId="SeverityFatal" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <ToggleButton x:Uid="FilterMatchCase" x:Name="FilterMatchCase" Content="Aa" Style="{StaticResource OptionToggleStyle}"
                              ToolTipService.ToolTip="Match case"
                              AutomationProperties.Name="Match case" />
                <ToggleButton x:Uid="FilterWholeWord" x:Name="FilterWholeWord" Content="[ab]" Style="{StaticResource OptionToggleStyle}" MinWidth="40"
                              ToolTipService.ToolTip="Match whole word"
                              AutomationProperties.Name="Match whole word" />
                <ToggleButton x:Uid="FilterRegex" x:Name="FilterRegex" Content=".*" Style="{StaticResource OptionToggleStyle}"
                              ToolTipService.ToolTip="Use regular expression"
                              AutomationProperties.Name="Use regular expression" />
            </StackPanel>
            <Button x:Uid="FilterApplyButton" Grid.Column="2" Content="Apply" Click="FilterApply_Click" VerticalAlignment="Center"
                    ToolTipService.ToolTip="Show only matching lines (Enter)" />
            <TextBlock x:Name="FilterStatus" Grid.Column="3" VerticalAlignment="Center" Margin="8,0"
                       TextTrimming="CharacterEllipsis" />
            <Button x:Uid="FilterCloseButton" Grid.Column="4" Content="&#x2715;" VerticalAlignment="Center" Click="FilterClose_Click"
                    AutomationProperties.Name="Clear filter and close"
                    ToolTipService.ToolTip="Clear filter and close (Esc)" />
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ReaderReturnGutterColumn" Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- The reader background spans the entire available reading viewport. Only the content group
                 below is width-limited and centered; annotation panels remain in their independent column. -->
            <Grid x:Name="ReaderViewport" Grid.Row="0" Grid.Column="1">
                <Border x:Name="ReaderViewportBackground" Background="White" IsHitTestVisible="False" />
                <Grid x:Name="ReaderContentHost" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                    </Grid.ColumnDefinitions>

                    <controls:TextCanvas x:Name="View" AutomationProperties.AutomationId="TextCanvas"
                                         Grid.Row="0" Grid.Column="0" />

                    <!-- Marker overview-ruler: find-match (orange) and bookmark (blue) ticks.
                         It stays aligned with the centered text surface and does not intercept pointer input. -->
                    <canvas:CanvasControl x:Name="MarkerMargin" Grid.Row="0" Grid.Column="1"
                                          Width="6" HorizontalAlignment="Stretch" IsHitTestVisible="False"
                                          Draw="MarkerMargin_Draw" />
                </Grid>
            </Grid>

            <Border x:Name="SmallAnnotationPane" Grid.Row="0" Grid.Column="2" Grid.RowSpan="1"
                    Width="360" Visibility="Collapsed"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                <Grid Padding="12" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="小批注" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock x:Name="SmallAnnotationCount" Text="0 条批注"
                                       Style="{ThemeResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="×" Click="CloseSmallAnnotations_Click"
                                MinWidth="32" Padding="4,2" ToolTipService.ToolTip="关闭小批注面板" />
                    </Grid>
                    <TextBox x:Name="SmallAnnotationSearchBox" Grid.Row="1"
                             PlaceholderText="搜索标题、批注内容或关联原文..."
                             TextChanged="SmallAnnotationSearchBox_TextChanged" />
                    <Grid Grid.Row="2" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="SmallAnnotationCategoryFilter" HorizontalAlignment="Stretch"
                                  SelectionChanged="SmallAnnotationCategoryFilter_SelectionChanged" />
                        <Button Grid.Column="1" Content="分类管理..." Click="ManageSmallAnnotationCategories_Click"
                                Padding="8,4" />
                    </Grid>
                    <Grid Grid.Row="3">
                        <ListView x:Name="SmallAnnotationList"
                                  SelectionChanged="SmallAnnotationList_SelectionChanged"
                                  SelectionMode="Single" />
                        <TextBlock x:Name="SmallAnnotationEmptyState"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Opacity="0.65"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed" />
                    </Grid>
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
                        <Button Content="删除" Click="DeleteSelectedSmallAnnotation_Click"
                                x:Name="DeleteSmallAnnotationButton" IsEnabled="False" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="ChapterAnnotationPane" Grid.Row="0" Grid.Column="2" Grid.RowSpan="1"
                    Width="360" Visibility="Collapsed"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                <Grid Padding="12" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="章节批注" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock x:Name="ChapterAnnotationCount" Text="0 条批注"
                                       Style="{ThemeResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button x:Name="RebuildChapterIndexButton" Content="重新识别"
                                    Click="RebuildChapterIndex_Click" Padding="8,4"
                                    ToolTipService.ToolTip="重新扫描原文章节，并在确认后更新索引" />
                            <Button Content="×" Click="CloseChapterAnnotations_Click"
                                    MinWidth="32" Padding="4,2" ToolTipService.ToolTip="关闭章节批注面板" />
                        </StackPanel>
                    </Grid>
                    <TextBox x:Name="ChapterAnnotationSearchBox" Grid.Row="1"
                             PlaceholderText="搜索标题或批注内容..."
                             TextChanged="ChapterAnnotationSearchBox_TextChanged" />
                    <ComboBox x:Name="ChapterAnnotationChapterFilter" Grid.Row="2"
                              HorizontalAlignment="Stretch"
                              PlaceholderText="全部章节"
                              MaxDropDownHeight="420"
                              SelectionChanged="ChapterAnnotationChapterFilter_SelectionChanged"
                              DropDownClosed="ChapterAnnotationChapterFilter_DropDownClosed" />
                    <Grid Grid.Row="3" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ChapterAnnotationCategoryFilter" HorizontalAlignment="Stretch"
                                  PlaceholderText="全部分类" MaxDropDownHeight="420"
                                  SelectionChanged="ChapterAnnotationCategoryFilter_SelectionChanged" />
                        <Button Grid.Column="1" Content="分类管理..." Click="ManageChapterAnnotationCategories_Click"
                                Padding="8,4" />
                    </Grid>
                    <Grid Grid.Row="4">
                        <ListView x:Name="ChapterAnnotationList"
                                  SelectionChanged="ChapterAnnotationList_SelectionChanged"
                                  SelectionMode="Single" />
                        <TextBlock x:Name="ChapterAnnotationEmptyState"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Opacity="0.65"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed" />
                    </Grid>
                    <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8">
                        <Button Content="新建" Click="NewChapterAnnotation_Click"
                                x:Name="NewChapterAnnotationButton" IsEnabled="False" />
                        <Button Content="编辑" Click="EditSelectedChapterAnnotation_Click"
                                x:Name="EditChapterAnnotationButton" IsEnabled="False" />
                        <Button Content="删除" Click="DeleteSelectedChapterAnnotation_Click"
                                x:Name="DeleteChapterAnnotationButton" IsEnabled="False" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="ChapterDirectoryPane" Grid.Row="0" Grid.Column="2" Grid.RowSpan="1"
                    Width="320" Visibility="Collapsed"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                <Grid Padding="12" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="章节目录" FontSize="17" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="×" Click="CloseChapterDirectory_Click"
                                MinWidth="32" Padding="4,2" ToolTipService.ToolTip="关闭章节目录" />
                    </Grid>
                    <TextBox x:Name="ChapterDirectorySearchBox" Grid.Row="1"
                             PlaceholderText="搜索章节标题..."
                             TextChanged="ChapterDirectorySearchBox_TextChanged"
                             KeyDown="ChapterDirectorySearchBox_KeyDown" />
                    <Grid Grid.Row="2">
                        <ListView x:Name="ChapterDirectoryList"
                                  IsItemClickEnabled="True"
                                  ItemClick="ChapterDirectoryList_ItemClick"
                                  SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="core:NovelChapter">
                                    <Grid Padding="8,7">
                                        <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="ChapterDirectoryEmptyState"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Opacity="0.65"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </Border>

            <Button x:Name="ReturnToBigAnnotationButton" Grid.Row="0" Grid.Column="0"
                    Width="76" Height="44" MinWidth="76" MinHeight="44"
                    CornerRadius="22"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="4" Padding="6,0" Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Click="ReturnToBigAnnotationWorkspace_Click"
                    ToolTipService.ToolTip="返回大批注工作区">
                <StackPanel Orientation="Horizontal" Spacing="4"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    <TextBlock Text="返回" FontSize="12" />
                </StackPanel>
            </Button>

        </Grid>


        <!-- A sibling overlay keeps the reader's Grid column measurements unchanged.
             Its empty area has no background, so mouse-wheel input still reaches the reader underneath. -->
        <Grid x:Name="ReaderOverlayHost" Grid.Row="3">
            <Border x:Name="ReaderSettingsPanel"
                    Width="360" Margin="0,0,56,0"
                    HorizontalAlignment="Right" VerticalAlignment="Stretch"
                    Visibility="Collapsed"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                    BorderThickness="1,0,1,0">
                <local:ReaderSettingsPane x:Name="ReaderSettingsControl" />
            </Border>

            <!-- The right-edge rail stays available while the settings panel is open. Future reader tools
                 (directory, annotations, etc.) can join this same vertical stack. -->
            <StackPanel x:Name="ReaderToolsRail"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,8,0" Spacing="10">
                <Button x:Uid="ReaderSettingsToggleButton" x:Name="ReaderSettingsToggleButton"
                        AutomationProperties.AutomationId="ReaderSettingsToggleButton"
                        Width="44" Height="44" MinWidth="44" MinHeight="44"
                        Padding="0" CornerRadius="22"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Click="ReaderSettingsToggle_Click">
                    <FontIcon Glyph="&#xE713;" FontSize="18" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="BigAnnotationWorkspace" Grid.Row="3" Visibility="Collapsed"
              Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <Grid x:Name="BigAnnotationListView" Padding="16" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="大批注" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock x:Name="BigAnnotationCount" Text="0 条大批注"
                                   Style="{ThemeResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="×" Click="CloseBigAnnotationWorkspace_Click"
                            MinWidth="36" Padding="4,2" ToolTipService.ToolTip="关闭大批注工作区" />
                </Grid>
                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="BigAnnotationSearchBox"
                             PlaceholderText="搜索标题、正文或关联章节..."
                             TextChanged="BigAnnotationSearchBox_TextChanged" />
                    <ComboBox x:Name="BigAnnotationCategoryFilter" Grid.Column="1"
                              HorizontalAlignment="Stretch" PlaceholderText="全部分类"
                              SelectionChanged="BigAnnotationCategoryFilter_SelectionChanged" />
                    <Button Grid.Column="2" Content="分类管理..." Click="ManageBigAnnotationCategories_Click"
                            Padding="10,4" />
                </Grid>
                <Grid Grid.Row="2">
                    <ListView x:Name="BigAnnotationList"
                              SelectionChanged="BigAnnotationList_SelectionChanged"
                              SelectionMode="Single" />
                    <TextBlock x:Name="BigAnnotationEmptyState"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" Opacity="0.65"
                               IsHitTestVisible="False" Visibility="Collapsed" />
                </Grid>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                    <Button Content="新建" Click="NewBigAnnotation_Click" />
                    <Button x:Name="OpenBigAnnotationButton" Content="打开 / 编辑"
                            Click="OpenSelectedBigAnnotation_Click" IsEnabled="False" />
                    <Button x:Name="DeleteBigAnnotationButton" Content="删除"
                            Click="DeleteSelectedBigAnnotation_Click" IsEnabled="False" />
                </StackPanel>
            </Grid>

            <Grid x:Name="BigAnnotationEditorView" Visibility="Collapsed" RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Padding="12" ColumnSpacing="10"
                      Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Content="← 返回列表" Click="BackToBigAnnotationList_Click"
                            VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="BigAnnotationEditorHeader" Text="编辑大批注"
                                   FontSize="17" FontWeight="SemiBold" />
                        <TextBlock x:Name="BigAnnotationEditorChapterRange"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="调整章节范围"
                            Click="AdjustBigAnnotationRange_Click" VerticalAlignment="Center" />
                    <Button Grid.Column="3" Content="保存" Click="SaveBigAnnotation_Click"
                            VerticalAlignment="Center" />
                    <Button Grid.Column="4" Content="×" Click="CloseBigAnnotationWorkspace_Click"
                            MinWidth="36" Padding="4,2" VerticalAlignment="Center"
                            ToolTipService.ToolTip="关闭大批注工作区" />
                </Grid>

                <Grid x:Name="BigAnnotationEditorColumns" Grid.Row="1" ColumnSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="BigAnnotationReferenceColumn" Width="460" MinWidth="280" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" MinWidth="360" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Padding="12" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="参考资料" FontSize="16" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" x:Name="BigAnnotationReferenceCount"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <TextBox x:Name="BigAnnotationReferenceSearchBox" Grid.Row="1"
                                 PlaceholderText="搜索参考批注标题、正文或原文..."
                                 TextChanged="BigAnnotationReferenceSearchBox_TextChanged" />
                        <Grid Grid.Row="2" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" ColumnSpacing="6"
                                  HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="BigAnnotationSmallCategoryFilter"
                                          Width="150"
                                          PlaceholderText="小批：全部分类"
                                          SelectionChanged="BigAnnotationSmallCategoryFilter_SelectionChanged" />
                                <ToggleSwitch x:Name="BigAnnotationSmallVisibilityToggle" Grid.Column="1"
                                              Width="48" OnContent="" OffContent=""
                                              VerticalAlignment="Center" />
                            </Grid>
                            <Grid Grid.Column="1" ColumnSpacing="6"
                                  HorizontalAlignment="Right">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="BigAnnotationChapterCategoryFilter"
                                          Width="150"
                                          PlaceholderText="章批：全部分类"
                                          SelectionChanged="BigAnnotationChapterCategoryFilter_SelectionChanged" />
                                <ToggleSwitch x:Name="BigAnnotationChapterVisibilityToggle" Grid.Column="1"
                                              Width="48" OnContent="" OffContent=""
                                              VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="BigAnnotationReferenceGroups" Spacing="3" />
                        </ScrollViewer>
                    </Grid>

                    <primitives:Thumb Grid.Column="1" Width="8"
                                      Background="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                      DragDelta="BigAnnotationSplitter_DragDelta"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                    <Grid Grid.Column="2" Padding="16" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="大批注正文" FontSize="16" FontWeight="SemiBold" />
                        <TextBox x:Name="BigAnnotationEditorTitleBox" Grid.Row="1"
                                 PlaceholderText="输入大批注标题（可选）" />
                        <ComboBox x:Name="BigAnnotationEditorCategoryFilter" Grid.Row="2"
                                  HorizontalAlignment="Stretch" PlaceholderText="未分类" />
                        <TextBox x:Name="BigAnnotationEditorContentBox" Grid.Row="3"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 PlaceholderText="在这里整理跨章节剧情、人物成长、势力变化、伏笔发展与回收……" />
                        <TextBlock x:Name="BigAnnotationEditorStatus" Grid.Row="4"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="4" Padding="8,3" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock x:Name="LblStatus" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                <!-- Shared determinate progress for the long operations (index rebuild, filter scan, sample
                     generation); collapsed when idle so it takes no space (#144). -->
                <ProgressBar x:Name="StatusProgress" Width="120" Minimum="0" Maximum="100" VerticalAlignment="Center"
                             Visibility="Collapsed" AutomationProperties.AutomationId="StatusProgress"
                             AutomationProperties.Name="Operation progress" />
                <Button x:Uid="SampleCancelButton" x:Name="SampleCancelButton" Visibility="Collapsed"
                        FontSize="12" Padding="8,1" MinHeight="0" VerticalAlignment="Center"
                        AutomationProperties.AutomationId="SampleCancelButton" Click="SampleCancel_Click" />
            </StackPanel>
            <HyperlinkButton x:Uid="ReloadHint" x:Name="ReloadHint" Grid.Column="1" Visibility="Collapsed"
                             Content="↻ File changed on disk — Reload" FontSize="12"
                             Padding="6,0" MinHeight="0" Margin="0,0,16,0" VerticalAlignment="Center"
                             ToolTipService.ToolTip="The file changed on disk. Click or press F5 to reload."
                             Click="Reload_Click" />
            <TextBlock x:Name="LblCharCount" Grid.Column="2" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,0,16,0" VerticalAlignment="Center" />
            <HyperlinkButton x:Uid="CountCharsLink" x:Name="CountCharsLink" Grid.Column="3" Visibility="Collapsed"
                             Content="Count characters" FontSize="12"
                             Padding="6,0" MinHeight="0" Margin="0,0,16,0" VerticalAlignment="Center"
                             AutomationProperties.AutomationId="CountCharsLink"
                             ToolTipService.ToolTip="Count the exact number of characters (one full pass over a large file)."
                             Click="CountChars_Click" />
            <TextBlock x:Name="LblZoom" Grid.Column="4" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,0,16,0" VerticalAlignment="Center" />
            <TextBlock x:Name="LblEncoding" Grid.Column="5" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,0,16,0" VerticalAlignment="Center" />
            <TextBlock x:Name="LblLineEnding" Grid.Column="6" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,0,16,0" VerticalAlignment="Center"
                       ToolTipService.ToolTip="Line endings used by the file" />
            <TextBlock x:Name="LblCursor" Grid.Column="7" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
